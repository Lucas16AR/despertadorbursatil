TELEGRAM_BOT_TOKEN=
# Canal público de Telegram donde publica el bot (ej. @despertadorbursatil) o su id -100…
# El bot tiene que ser administrador del canal con permiso de publicar.
TELEGRAM_CHAT_ID=
BCRA_API_TOKEN=
ANTHROPIC_API_KEY=
# Tasa de referencia de la Fed (sección "Economía"). Opcional, no bloqueante: si falta, esa
# línea del mensaje se omite. Alta gratuita e inmediata en fredaccount.stlouisfed.org/apikeys.
FRED_API_KEY=
# Registro de envíos para el panel de administración (opcional, no bloqueante).
# service_role key: dashboard de Supabase → Project Settings → API → service_role (secret).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
